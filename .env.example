# Saathi — environment variables
# Copy this to .env for local dev. On Vercel, set these in Project Settings → Environment Variables.

# Required: Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional: override the model
# GEMINI_MODEL=gemini-2.5-flash

# Server port (local only; Vercel manages this)
# PORT=8080

# --- Google APIs (server-side only; proxied through /api/*) ---
# Required for Nearby (/api/nearby via Places API New), Weather + AQI
# (/api/conditions via Weather API + Air Quality API), and city geocoding.
# Enable in Google Cloud console: Places API (New), Weather API, Air Quality API, Geocoding API.
# If missing or a call fails, Saathi falls back to Google Maps deep links + Open-Meteo.
GOOGLE_MAPS_API_KEY=

# --- Speech stack (added in later milestones) ---
# Indic-specialised STT provider. Preferred for Hindi/Punjabi/code-mix.
# SARVAM_API_KEY=
# STT provider: "sarvam" (default when SARVAM_API_KEY is set) | "gemini" | "whisper"
# STT_PROVIDER=
# OPENAI_API_KEY=
# WHISPER_MODEL=whisper-1
